#!/usr/bin/env bash
set -Eeuo pipefail

: "${HOSTINGER_SSH_HOST:?Set HOSTINGER_SSH_HOST}"
: "${HOSTINGER_SSH_USER:?Set HOSTINGER_SSH_USER}"
HOSTINGER_SSH_PORT="${HOSTINGER_SSH_PORT:-65002}"

ssh -p "$HOSTINGER_SSH_PORT" -o BatchMode=yes -o StrictHostKeyChecking=yes \
  "${HOSTINGER_SSH_USER}@${HOSTINGER_SSH_HOST}" \
  'for root in domains/test.avinyacarefoundation.org/public_html domains/avinyacarefoundation.org/public_html; do printf "%s: " "$root"; test -s "$root/index.html" && test -s "$root/api/booking/index.php" && cat "$root/.release" 2>/dev/null || echo unhealthy; done'
