# Hostinger LiteSpeed / Apache Configuration for Avinya Care Foundation
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Route /api/news, /api/news/refresh, and /api/news/generate to physical endpoints if Node proxy is inactive
  RewriteRule ^api/news/?$ api/news.json [L,NC]
  RewriteRule ^api/news/refresh/?$ api/news.json [L,NC]
  RewriteRule ^api/news/generate/?$ api/news_generate.json [L,NC]
</IfModule>

# Enable CORS Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>
