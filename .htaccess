# Hostinger LiteSpeed / Apache Configuration for Avinya Care Foundation
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Route /api/submit-form to submit-form.php on Apache/PHP hosts
  RewriteRule ^api/submit-form/?$ api/submit-form.php [L,NC]

  # Persistent file-ledger booking API
  RewriteRule ^api/booking/whatsapp-webhook/?$ api/booking/index.php?action=whatsapp_webhook [QSA,L,NC]
  RewriteRule ^api/booking/slots/?$ api/booking/index.php?action=slots [QSA,L,NC]
  RewriteRule ^api/bookings/export/?$ api/booking/index.php?action=export [QSA,L,NC]
  RewriteRule ^api/bookings/?$ api/booking/index.php?action=list [QSA,L,NC]
  RewriteRule ^api/booking/?$ api/booking/index.php [QSA,L,NC]

  # Route /api/healthcare endpoints to dynamic MySQL PHP handlers
  RewriteRule ^api/healthcare/doctors/([^/]+)/slots/?$ api/booking/index.php?action=slots&doctorId=$1 [QSA,L,NC]
  RewriteRule ^api/healthcare/doctors(\.json)?/?$ api/healthcare/doctors.php [L,NC]
  RewriteRule ^api/healthcare/specialities(\.json)?/?$ api/healthcare/specialities.php [L,NC]
  RewriteRule ^api/healthcare/tests(\.json)?/?$ api/healthcare/tests.php [L,NC]

  # Route /api/news endpoints
  RewriteRule ^api/news/?$ api/news.php [L,NC]
  RewriteRule ^api/news/refresh/?$ api/news.php [L,NC]
  RewriteRule ^api/news/generate/?$ api/news_generate.json [L,NC]
</IfModule>

# Enable CORS Headers & Cache Control
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"

  # Prevent aggressive caching of HTML and PHP API files
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
