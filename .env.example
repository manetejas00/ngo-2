# Avinya Care Foundation - Environment Configuration Template
PORT=3000

# Google Gemini AI API Keys (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
AI_API_KEY=

# SMTP Email Configuration (Optional - Virtual Logger used if empty)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=care@avinyacare.org
SMTP_PASS=your_smtp_password_here
SMTP_FROM=care@avinyacare.org
ADMIN_EMAIL=admin@avinyacare.org

# Optional External News API Key
NEWS_API_KEY=
