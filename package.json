{
  "name": "avinya-care-ngo",
  "version": "4.2.1",
  "description": "AvinyaCareFoundation - Modern Healthcare & Cancer Awareness Platform",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node server.mjs",
    "dev": "node server.mjs",
    "build": "node scripts/preflight.mjs",
    "check": "node scripts/preflight.mjs",
    "test": "node scripts/preflight.mjs && node --test test/config.test.mjs test/gallery-service.test.mjs test/static-access.test.mjs",
    "deploy:live": "node scripts/deploy-remote.mjs",
    "smoke:staging": "node --dns-result-order=ipv4first scripts/live-smoke.mjs https://test.avinyacarefoundation.org",
    "smoke:production": "node --dns-result-order=ipv4first scripts/live-smoke.mjs https://avinyacarefoundation.org"
  },
  "keywords": [
    "ngo",
    "cancer-awareness",
    "health",
    "healthcare",
    "node"
  ],
  "author": "AvinyaCareFoundation",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "nodemailer": "^9.0.5",
    "ssh2": "^1.17.0"
  }
}
