# ===================================================================
# AVINYA CARE FOUNDATION — PRODUCTION ENVIRONMENT CONFIGURATION
# Node.js Server Environment Variables (Hostinger & Local Production)
# ===================================================================

# Server Port Configuration
PORT=3000

# -------------------------------------------------------------------
# GOOGLE GEMINI AI API KEYS & PROJECT CONFIGURATION
# Project ID: gen-lang-client-0663449346 | Project Number: 503925019049
# -------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=gen-lang-client-0663449346
GOOGLE_PROJECT_NUMBER=503925019049

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
AI_API_KEY=YOUR_AI_API_KEY_HERE

# -------------------------------------------------------------------
# EMAIL DISPATCH SERVICE (SMTP Settings)
# Optional: Configure real SMTP credentials for Hostinger / Gmail / SendGrid.
# If omitted or left empty, the server automatically uses virtual mail logging (cache/email_logs.json).
# -------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=care@avinyacare.org
SMTP_PASS=
SMTP_FROM=care@avinyacare.org
ADMIN_EMAIL=admin@avinyacare.org

# -------------------------------------------------------------------
# MULTI-PROVIDER PUBLIC NEWS & SCIENCE APIS (Public APIs Repository)
# All free open-access health, science & medical research news endpoints
# -------------------------------------------------------------------
NEWS_API_HEALTH_IN=https://saurav.tech/NewsAPI/top-headlines/category/health/in.json
NEWS_API_HEALTH_US=https://saurav.tech/NewsAPI/top-headlines/category/health/us.json
NEWS_API_SCIENCE_IN=https://saurav.tech/NewsAPI/top-headlines/category/science/in.json
NEWS_API_SCIENCE_US=https://saurav.tech/NewsAPI/top-headlines/category/science/us.json
NEWS_API_SPACEFLIGHT=https://api.spaceflightnewsapi.net/v4/blogs/?limit=10

# Comma-separated list of all news endpoints queried concurrently
NEWS_API_URLS=https://saurav.tech/NewsAPI/top-headlines/category/health/in.json,https://saurav.tech/NewsAPI/top-headlines/category/health/us.json,https://saurav.tech/NewsAPI/top-headlines/category/science/in.json,https://saurav.tech/NewsAPI/top-headlines/category/science/us.json,https://api.spaceflightnewsapi.net/v4/blogs/?limit=10

NEWS_API_URL=https://saurav.tech/NewsAPI/top-headlines/category/health/in.json
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE
