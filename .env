# ===================================================================
# AVINYA CARE FOUNDATION — PRODUCTION ENVIRONMENT CONFIGURATION
# Node.js Server Environment Variables (Hostinger & Local Production)
# ===================================================================

# Server Port Configuration
PORT=3000

# -------------------------------------------------------------------
# GOOGLE GEMINI AI API KEYS & PROJECT CONFIGURATION
# Project ID: gen-lang-client-0663449346 | Project Number: 503925019049
# -------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=gen-lang-client-0663449346
GOOGLE_PROJECT_NUMBER=503925019049

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
AI_API_KEY=YOUR_AI_API_KEY_HERE

# -------------------------------------------------------------------
# EMAIL DISPATCH SERVICE (SMTP Settings)
# Optional: Configure real SMTP credentials for Hostinger / Gmail / SendGrid.
# If omitted or left empty, the server automatically uses virtual mail logging (cache/email_logs.json).
# -------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=care@avinyacare.org
SMTP_PASS=
SMTP_FROM=care@avinyacare.org
ADMIN_EMAIL=admin@avinyacare.org

# -------------------------------------------------------------------
# EXTERNAL HEALTH NEWS API (Optional)
# Optional API key for newsapi.org health headlines.
# Fallback cancer news dataset is used automatically if key is empty.
# -------------------------------------------------------------------
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE
